<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AutopilotKwp</AssemblyName>
    <RootNamespace>AutopilotKwp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony ships with the game install (000_Harmony). Without it only this DLL fails to load. -->
    <Reference Include="0Harmony">
      <HintPath>$(KSPDir)\GameData\000_Harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\AutopilotHost\AutopilotHost.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyKwpToKsp" AfterTargets="Build">
    <PropertyGroup>
      <KspPluginsDir>$(KSPDir)\GameData\MyAutopilot\Plugins</KspPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(KspPluginsDir)" />
    <!-- The game locks this DLL while KSP is open. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KspPluginsDir)" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Message Importance="high" Text="AutopilotKwp copied to $(KspPluginsDir)" />
  </Target>
</Project>
